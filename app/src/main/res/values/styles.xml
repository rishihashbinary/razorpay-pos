<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Label">
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="Value">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/green_700</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/gray_700</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
</resources>