<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reason_for_rejection"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/edtRemarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/additional_remarks_optional"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/txtLocationChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_neutral"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textSize="13sp"
        android:textColor="#424242"
        tools:text="Location captured · ±11m" />

    <LinearLayout
        android:id="@+id/evidenceSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtEvidenceHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/evidence_optional"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#777777"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAddPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_neutral"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/add_photo"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipVoiceNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_neutral"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/voice_note"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnSubmitFailure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/submit"
        android:layout_marginTop="16dp" />

</LinearLayout>